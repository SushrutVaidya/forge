<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.forge</groupId>
  <artifactId>forge</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <packaging>pom</packaging>

  <name>Forge Framework</name>
  <description>An AI-native Java framework: a lightweight inversion-of-control container built from first principles.</description>

  <modules>
    <module>forge-core</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- Retain method parameter names in bytecode so tool schemas can use them. -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Dependency versions: one authoritative place for the whole reactor. -->
    <junit.version>5.11.4</junit.version>

    <!-- Plugin versions: pinned for reproducible builds. -->
    <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- The JUnit BOM aligns every junit-* artifact to a single, consistent version. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
